{
  "rules": {
    "access": {
      ".read": true,
      ".write": "!data.exists() || !newData.child('academyFirstUsedAt').exists() || !data.child('academyFirstUsedAt').exists() || data.child('academyFirstUsedAt').val() === 0"
    },
    "users": {
      "$deviceId": {
        ".read": false,
        ".write": "$deviceId === auth.uid || !data.exists()"
      }
    }
  }
}
