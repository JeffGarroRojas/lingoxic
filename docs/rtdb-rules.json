{
  "rules": {
    "access": {
      ".read": true,
      ".write": "!data.exists() || !data.child('academyFirstUsedAt').exists() || data.child('academyFirstUsedAt').val() === 0"
    },
    "users": {
      "$deviceId": {
        ".read": true,
        ".write": "!data.exists() || data.child('deviceId').val() === $deviceId"
      }
    }
  }
}
