{
  "rules": {
    "access": {
      ".read": true,
      ".write": "!data.exists() || !data.child('academyFirstUsedAt').exists() || data.child('academyFirstUsedAt').val() === 0 || newData.child('academyFirstUsedAt').val() === data.child('academyFirstUsedAt').val()"
    },
    "users": {
      "$deviceId": {
        ".read": true,
        ".write": "!data.exists() || data.child('deviceId').val() === $deviceId"
      }
    },
    "progress": {
      "$userId": {
        ".read": true,
        ".write": "!data.exists() || newData.child('updatedAt').isNumber()",
        ".validate": "newData.hasChildren(['name', 'level', 'xp', 'updatedAt']) && newData.child('xp').isNumber() && newData.child('level').isString() && newData.child('updatedAt').isNumber()"
      }
    }
  }
}
